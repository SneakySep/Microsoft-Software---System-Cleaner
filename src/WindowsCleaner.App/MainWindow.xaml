<Window x:Class="WindowsCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsCleaner.App.Converters"
        Title="Windows Cleaner"
        Height="780"
        Width="1060"
        MinHeight="600"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:ByteSizeConverter x:Key="ByteSize" />
        <conv:RelativeTimeConverter x:Key="RelativeTime" />
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- header -->
            <RowDefinition Height="Auto" />
            <!-- stat cards -->
            <RowDefinition Height="Auto" />
            <!-- progress -->
            <RowDefinition Height="Auto" />
            <!-- actions -->
            <RowDefinition Height="Auto" />
            <!-- extra folders -->
            <RowDefinition Height="Auto" />
            <!-- result banner -->
            <RowDefinition Height="*" />
            <!-- results list -->
            <RowDefinition Height="Auto" />
            <!-- last clean -->
            <RowDefinition Height="Auto" />
            <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Windows Cleaner" />
                <TextBlock Style="{StaticResource Text.Subtitle}"
                           Margin="0,3,0,0"
                           Text="Reclaim disk space from Windows and application temporary folders." />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <!--
                    Shown only when running unelevated, so the user understands up front why
                    C:\Windows\Temp will be reported as inaccessible rather than cleaned.
                -->
                <Border Background="{StaticResource Brush.BannerWarnFill}"
                        BorderBrush="{StaticResource Brush.BannerWarnBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Visibility="{Binding ShowElevationNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{StaticResource Brush.Warning}" />

                        <!--
                            Windows Temp is skipped rather than failing, so the limitation is stated
                            and the way out of it is offered right here, instead of demanding consent
                            up front from everyone.
                        -->
                        <TextBlock Text="Standard user &#x2014; Windows Temp is skipped"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Warning}" />

                        <Button Content="Restart as administrator"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding RestartElevatedCommand}"
                                ToolTip="Restart with administrator rights so Windows Temp can be cleaned too"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!--
                    Confirms the restart actually worked. Worth a line of its own: "the banner went
                    away" is a weak signal for something as consequential as running elevated.
                -->
                <Border Background="{StaticResource Brush.BannerGoodFill}"
                        BorderBrush="{StaticResource Brush.BannerGoodBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Visibility="{Binding ShowElevatedNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Text="Running as administrator &#x2014; Windows Temp included"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Success}" />
                    </StackPanel>
                </Border>

                <!-- Opens the scheduled cleaning dialog. -->
                <Button Content="Scheduled cleaning&#x2026;"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenSchedulerCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============================ Stat cards ============================ -->
        <!--
            These reflect the current *selection*, not the raw scan totals: the number that
            matters is what pressing Clean Now would actually remove.
        -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,15">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.StatValue}" Text="{Binding SelectedSizeText}" />
                    <TextBlock Style="{StaticResource Text.StatLabel}" Text="Selected to clean" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.StatValue}" Text="{Binding SelectedCountText}" />
                    <TextBlock Style="{StaticResource Text.StatLabel}" Text="Files selected" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,15">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.StatValue}" Text="{Binding LocationText}" />
                    <TextBlock Style="{StaticResource Text.StatLabel}" Text="Locations reachable" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== Progress ============================ -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <ProgressBar Style="{StaticResource ThinProgressBar}"
                         Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="{StaticResource Brush.TextTertiary}"
                       Text="{Binding CurrentPathText}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- ============================== Actions ============================= -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!--
                    Scan is a secondary, glassy action: it changes nothing, it only reads. The one
                    accent-filled button on the page is the one that removes things.
                -->
                <Button Content="Scan"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanCommand}" />
                <Button Content="Clean Now"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CleanCommand}"
                        Margin="10,0,0,0" />
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       MaxWidth="440"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource Text.Subtitle}"
                       Text="{Binding StatusText}" />
        </Grid>

        <!-- =========================== Extra folders ========================== -->
        <!--
            Additive folders on top of the standard Windows locations, persisted between runs.
            Everything added here still goes through the same allowlist and guard rails.
        -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <TextBlock Text="Extra folders"
                       Style="{StaticResource Text.Subtitle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <ItemsControl ItemsSource="{Binding CustomFolders}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}"
                                BorderBrush="{StaticResource Brush.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,3,3,3"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           MaxWidth="240"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding}"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <Button Content="&#xE711;"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="10"
                                        Style="{StaticResource LinkButton}"
                                        Padding="5,3"
                                        Margin="4,0,0,0"
                                        ToolTip="Remove this folder"
                                        Command="{Binding DataContext.RemoveFolderCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Only the standard Windows locations are scanned."
                       Style="{StaticResource Text.Subtitle}"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasNoCustomFolders, Converter={StaticResource BoolToVisibility}}" />

            <Button Content="+ Add folder"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding AddFolderCommand}"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0" />
        </StackPanel>

        <!-- =========================== Result banner ========================== -->
        <Border Grid.Row="5"
                Margin="0,14,0,0"
                CornerRadius="8"
                Padding="14,10"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.BannerWarnFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BannerWarnBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <!-- Green when something was actually removed, amber when nothing was. -->
                        <DataTrigger Binding="{Binding BannerIsPositive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.BannerGoodFill}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.BannerGoodBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding BannerText}" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- =========================== Results list =========================== -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- selection toolbar -->
                    <RowDefinition Height="Auto" />
                    <!-- column headers -->
                    <RowDefinition Height="*" />
                    <!-- rows -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Select all"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding SelectAllCommand}" />
                        <Button Content="Select none"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding SelectNoneCommand}"
                                Margin="2,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!--
                            Persistent reminder that recycled files still occupy the volume until
                            the bin is emptied. Turns amber when there is something waiting.
                        -->
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRecycleBinHint}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <Binding Path="RecycleBinText" />
                            </TextBlock.Text>
                        </TextBlock>

                        <Button Content="Open"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenRecycleBinCommand}"
                                ToolTip="Open the Recycle Bin in Explorer"
                                Margin="0,0,2,0" />

                        <!--
                            Disabled until the bin holds enough to be worth emptying, so an
                            irreversible action is not sitting one click away from a bin the
                            user is keeping on purpose. The tooltip says which.
                        -->
                        <Button Content="Empty"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding EmptyRecycleBinCommand}"
                                ToolTip="{Binding EmptyRecycleBinTooltip}"
                                Margin="0,0,10,0" />

                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                  Content="Move to Recycle Bin (undoable)"
                                  IsChecked="{Binding MoveToRecycleBin, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Grid>

                <!--
                    Right margin = row left padding (14) + scrollbar width (17).
                    The scrollbar is pinned visible below so this offset is always exact and
                    the header columns line up with the rows at any DPI.
                -->
                <Grid Grid.Row="1" Margin="14,6,31,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.ColumnHeader}" Text="FILE" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.ColumnHeader}" Text="SIZE" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.ColumnHeader}" Text="AGE" HorizontalAlignment="Right" />
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Files}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,0,6"
                         ItemContainerStyle="{StaticResource JunkListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource ModernCheckBox}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FullPath}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding LastWriteTimeUtc, Converter={StaticResource RelativeTime}}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="{Binding EmptyStateText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           FontSize="13"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ============================ Last clean =========================== -->
        <!--
            The outcome of the most recent clean, carried over between runs and reflecting work
            done by either front-end, so an unattended cleanup is still visible in the morning.
        -->
        <StackPanel Grid.Row="7"
                    Margin="2,12,0,0"
                    Visibility="{Binding HasLastClean, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LAST CLEAN"
                           Style="{StaticResource Text.ColumnHeader}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding LastCleanHeadline}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}" />
                <Button Content="Details"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding ToggleLastCleanDetailsCommand}"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0" />
                <Button Content="History"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding ToggleHistoryCommand}"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}"
                    Margin="0,6,0,0"
                    Padding="13,10"
                    Visibility="{Binding ShowLastCleanDetails, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LastCleanDetails}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </Border>

            <!--
                The recent runs, with the totals underneath. One run says very little on its own; a
                few of them are what shows whether the cleaning is actually keeping up.
            -->
            <Border Style="{StaticResource Card}"
                    Margin="0,6,0,0"
                    Padding="13,10"
                    Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="WHEN" Style="{StaticResource Text.ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="RUN BY" Style="{StaticResource Text.ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="RESULT" Style="{StaticResource Text.ColumnHeader}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoryRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding When}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Origin}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Result}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding HistorySummary}"
                               Margin="0,7,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextTertiary}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================== Footer ============================== -->
        <TextBlock Grid.Row="8"
                   Margin="2,12,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextTertiary}"
                   Text="{Binding SkippedText}" />
    </Grid>
</Window>
