<Window x:Class="WindowsCleaner.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled cleaning"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <StackPanel Margin="26,22,26,20">

        <TextBlock Style="{StaticResource Text.Title}" Text="Scheduled cleaning" />
        <TextBlock Style="{StaticResource Text.Subtitle}"
                   Margin="0,3,0,0"
                   TextWrapping="Wrap"
                   Text="Runs the cleaner unattended on a schedule, through Windows' own Task Scheduler, so it works whether or not this app is open." />

        <!-- ============================ Current state ============================ -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,13">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusHeadline}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusDetail}"
                           Margin="16,6,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}" />

                <!--
                    Both come from the job's own record and definition rather than from Task
                    Scheduler's report, whose labels are localised.
                -->
                <TextBlock Text="{Binding LastRunText}"
                           Margin="16,6,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding NextRunText}"
                           Margin="16,3,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    Shown when the registered job was created with a different freshness guard, so
                    applying the settings here is never a surprise change.
                -->
                <TextBlock Text="{Binding GuardNote}"
                           Margin="16,7,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Warning}"
                           Visibility="{Binding HasGuardNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ============================== Settings ============================== -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Frequency -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Runs"
                           Style="{StaticResource Text.Subtitle}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="DailyButton"
                                  Style="{StaticResource SegmentToggle}"
                                  Content="Every day"
                                  IsChecked="{Binding IsDaily, Mode=TwoWay}" />
                    <ToggleButton x:Name="WeeklyButton"
                                  Style="{StaticResource SegmentToggle}"
                                  Content="Every week"
                                  Margin="6,0,0,0"
                                  IsChecked="{Binding IsWeekly, Mode=TwoWay}" />
                </StackPanel>

                <!-- Weekday, only meaningful for a weekly schedule -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="On"
                           Style="{StaticResource Text.Subtitle}"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsWeeklySchedule, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Grid.Row="1" Grid.Column="1"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding Days}"
                              Visibility="{Binding IsWeeklySchedule, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource SegmentToggle}"
                                          Content="{Binding Label}"
                                          Padding="9,5"
                                          Margin="0,0,4,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Time -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="At"
                           Style="{StaticResource Text.Subtitle}"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox Style="{StaticResource FieldTextBox}"
                             Width="76"
                             Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="24-hour, e.g. 03:30"
                               Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- Disposal mode -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Disposal"
                           Style="{StaticResource Text.Subtitle}"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <ToggleButton Style="{StaticResource SegmentToggle}"
                                  Content="Recycle Bin"
                                  IsChecked="{Binding IsRecycleMode, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource SegmentToggle}"
                                  Content="Delete permanently"
                                  Margin="6,0,0,0"
                                  IsChecked="{Binding IsPermanentMode, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="1"
                           Margin="0,9,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           Text="Unattended runs only clean files that have been untouched for at least 24 hours. Nothing else watches over them, so the freshness guard is what keeps a job that runs while you are asleep from removing a file something is still using." />
            </Grid>
        </Border>

        <!-- ============================ The CLI target =========================== -->
        <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
            <TextBlock Text="{Binding CliSummary}"
                       Style="{StaticResource Text.Subtitle}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       VerticalAlignment="Center" />
            <Button Content="Browse for wclean.exe"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding BrowseCommand}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Visibility="{Binding ShowBrowseForCli, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ============================== Outcome =============================== -->
        <Border Margin="0,12,0,0"
                CornerRadius="8"
                Padding="13,9"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFEDF8F3" />
                    <Setter Property="BorderBrush" Value="#FFBFE3D3" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                            <Setter Property="Background" Value="#FFFDF6E9" />
                            <Setter Property="BorderBrush" Value="#FFF0D9AE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding MessageText}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- ============================== Actions =============================== -->
        <Grid Margin="0,18,0,0">
            <!--
                Running the job is kept away from the buttons that change it: what runs is what the
                scheduler holds, not what the form above currently says.
            -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Run now"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RunNowCommand}"
                        ToolTip="Run the registered job immediately"
                        Visibility="{Binding ShowRunNow, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Stop"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding StopCommand}"
                        ToolTip="Stop the run in progress"
                        Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Turn off"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DisableCommand}"
                        Margin="0,0,10,0" />
                <Button Content="Turn on / update"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyCommand}" />
                <Button Content="Close"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding CloseCommand}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
