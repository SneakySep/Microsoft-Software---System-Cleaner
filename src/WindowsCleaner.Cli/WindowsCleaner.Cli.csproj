<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WindowsCleaner.Cli</RootNamespace>
    <AssemblyName>wclean</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same engine as the desktop app; the UI is the only thing that differs. -->
    <ProjectReference Include="..\WindowsCleaner.Core\WindowsCleaner.Core.csproj" />
  </ItemGroup>

</Project>
