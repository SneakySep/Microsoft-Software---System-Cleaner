<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately UI-free: this assembly has no reference to WPF, WinUI or WinForms.
    Everything here can run headless (tests, a CLI, a scheduled task) which is what
    keeps the scanning and deletion logic verifiable outside the app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test suite observe shell-level facts (recycle bin contents) directly. -->
    <InternalsVisibleTo Include="WindowsCleaner.Tests" />
  </ItemGroup>

</Project>
